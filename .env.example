# Environment variables actually read by the project.
# Copy to .env for local overrides.

# FastAPI host/port (used by `make run-api`; the Makefile provides these defaults).
API_HOST=0.0.0.0
API_PORT=8000

# Base URL of the prediction API (used by both Streamlit apps).
# Inside docker-compose this is set to http://api:8000 automatically.
API_URL=http://localhost:8000

# Log level for the API (DEBUG | INFO | WARNING | ERROR).
LOG_LEVEL=INFO
